# =============================================================================
# TryAnneal — local environment template
# Copy this to .env and fill in values. .env is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM ensemble (engine + CLI)
# -----------------------------------------------------------------------------
# ChainGPT — Web3-tuned model used for the audit pre-screen.
# Get a key: https://app.chaingpt.org/apps/api
CHAINGPT_API_KEY=

# Google AI Studio — Gemini 2.5 Pro critic.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — Llama 3.3 70B critic (very low TTFT on LPUs).
# Get a key: https://console.groq.com
GROQ_API_KEY=

# Tencent Cloud Hunyuan — 4th critic in the cascade (OpenAI-compatible).
# Console > Hunyuan > API Keys: https://console.cloud.tencent.com/hunyuan/api-key
# This is the Tencent Cloud integration for the Mantle Turing Test DevTools track.
HUNYUAN_API_KEY=
HUNYUAN_MODEL=hunyuan-turbos-latest

# Optional Anthropic fallback (unused by default; set if you want to swap
# ChainGPT for Claude on the pre-screen).
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Mantle deploy + on-chain attestation (packages/contracts)
# -----------------------------------------------------------------------------
# Funded Mantle Sepolia account. Faucet: https://faucet.sepolia.mantle.xyz
# 0x-prefixed hex private key.
DEPLOYER_PRIVATE_KEY=

# Optional — mantlescan API key for hardhat-verify.
# Get one: https://mantlescan.xyz/myapikey
MANTLESCAN_API_KEY=

# Optional — override the default deploy params.
# AGENT_URI=ipfs://tryanneal/agent.json
# STAKE_TOKEN=                       # If unset, deploy-all.ts deploys MockERC20
# MIN_STAKE=100                      # in ether units; default 100
# TREASURY=                          # defaults to deployer address

# -----------------------------------------------------------------------------
# Post-deploy: filled in after running scripts/deploy-all.ts
# (also persisted to packages/contracts/deployments/<network>.json)
# -----------------------------------------------------------------------------
# Anneal agent ID minted on ERC-8004 IdentityRegistry.
ANNEAL_AGENT_ID=

# AnnealValidation contract address (used by --attest and run-audits.ts).
VALIDATION_CONTRACT=

# -----------------------------------------------------------------------------
# Privacy — Arweave (optional)
# -----------------------------------------------------------------------------
# Either inline JWK JSON…
# ARWEAVE_JWK=
# …or a path to a JWK file (gitignored).
# ARWEAVE_JWK_PATH=./arweave-jwk.json
# Local fallback directory when no JWK is configured.
REPORTS_DIR=./reports
