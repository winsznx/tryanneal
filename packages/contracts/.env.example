# packages/contracts/.env — loaded by hardhat.config.ts via dotenv.
# Mirrors the root .env.example. You can keep both files identical, or just
# symlink the root file: `ln -s ../../.env packages/contracts/.env`.

DEPLOYER_PRIVATE_KEY=
MANTLESCAN_API_KEY=

# Optional deploy overrides
# AGENT_URI=ipfs://tryanneal/agent.json
# STAKE_TOKEN=
# MIN_STAKE=100
# TREASURY=

# Post-deploy
ANNEAL_AGENT_ID=
VALIDATION_CONTRACT=

# LLM keys for run-audits.ts batch run
CHAINGPT_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HUNYUAN_API_KEY=     # Tencent Cloud Hunyuan — DevTools track integration
HUNYUAN_MODEL=hy-mt2-plus
HUNYUAN_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1

REPORTS_DIR=./reports

# Optional Arweave (real upload). Without these, run-audits falls back to
# writing encrypted reports to REPORTS_DIR.
# ARWEAVE_JWK_PATH=./arweave-jwk.json
# ARWEAVE_JWK=
