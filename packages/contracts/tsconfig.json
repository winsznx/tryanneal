{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "node16",
      "moduleResolution": "node16"
    }
  },
  "include": ["./hardhat.config.ts", "./test/**/*", "./scripts/**/*"]
}
