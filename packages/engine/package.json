{
  "name": "@tryanneal/engine",
  "version": "0.1.3",
  "description": "TryAnneal audit engine \u2014 multi-LLM cascade + Slither + Mantle Arsia gas profiling + exploit corpus.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winsznx/tryanneal.git",
    "directory": "packages/engine"
  },
  "homepage": "https://tryanneal.xyz",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./slither": {
      "types": "./dist/slither.d.ts",
      "import": "./dist/slither.js",
      "default": "./dist/slither.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "benchmark": "tsx benchmarks/run.ts",
    "benchmark:gas": "tsx benchmarks/gas-bench.ts"
  },
  "dependencies": {
    "ethers": "^6.13.4"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0"
  }
}
